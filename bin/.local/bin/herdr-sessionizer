#!/bin/bash

# Personal projects are nested 1–4 levels deep, so fixed-depth discovery misses
# repos. Git roots give cleaner results than every directory (which includes
# categories, courses, and build output). Keep exclusions here for vendored or
# generated trees that may contain nested .git directories.
root=${HERDR_PROJECT_ROOT:-"$HOME/personal"}

if [ "$#" -eq 1 ]; then
  selected=$1
else
  selected=$(cd "$root" && fd --hidden --no-ignore --type d '^\.git$' . \
    --exclude node_modules \
    --exclude .cache \
    --exclude dist \
    --exclude build \
    --exclude target \
    --exclude vendor \
    | sed 's#^\./##; s#/.git/$##' \
    | sort -u \
    | fzf --prompt='personal workspace> ')
  [ -n "$selected" ] && selected="$root/$selected"
fi

[ -n "$selected" ] || exit 0
selected=$(cd "$selected" 2>/dev/null && pwd -P) || exit 1

# Relative labels stay readable and avoid collisions such as multiple "test"
# repos. Selecting an open label focuses it; otherwise Herdr creates workspace.
if [[ "$selected" == "$root/"* ]]; then
  label=${selected#"$root/"}
else
  label=$(basename "$selected" | tr . _)
fi

workspace_id=$(herdr workspace list | jq -r --arg label "$label" '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -1)

if [ -n "$workspace_id" ]; then
  herdr workspace focus "$workspace_id" >/dev/null
else
  herdr workspace create --cwd "$selected" --label "$label" --focus >/dev/null
fi
